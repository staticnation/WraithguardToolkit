msgid "rules file:"
msgstr ""

#: wraithguard_toolkit_gui.py:3786
msgid "Personal rules file the rule is appended to (created with a header if new). Use your OWN file, not mlox_base/mlox_user -- those get overwritten by 'Update Rules...'. It's auto-added to the rule-files list LAST, so your rules win conflicts."
msgstr ""

#: wraithguard_toolkit_gui.py:3801
msgid "Rule type"
msgstr ""

#: wraithguard_toolkit_gui.py:3824
msgid "Plugins (order matters for [Order])"
msgstr ""

#: wraithguard_toolkit_gui.py:3847
msgid "From plugin panel"
msgstr ""

#: wraithguard_toolkit_gui.py:3852
msgid "Add the rows currently SELECTED in the main plugin-order panel, in their displayed order (Ctrl/Shift-click there to multi-select first)."
msgstr ""

#: wraithguard_toolkit_gui.py:3859
msgid "Group as ANY"
msgstr ""

#: wraithguard_toolkit_gui.py:3863
msgid "Wrap the SELECTED plugins in an [ANY ...] group, for a rule that is satisfied by whichever of several versions someone has installed -- the shape the guidelines use for mods with an XB edition, a Tribunal edition and so on.\n\nSelect the grouped entry and press again to ungroup."
msgstr ""

#: wraithguard_toolkit_gui.py:3881
msgid "Type a plugin filename and press Enter. mlox wildcards are allowed: ? for one character, * for any run, <VER> for a version number -- though the guidelines ask for these to be used sparingly, since expanding them is slow."
msgstr ""

#: wraithguard_toolkit_gui.py:3888
msgid "Add"
msgstr ""

#: wraithguard_toolkit_gui.py:3896
msgid "Message and source"
msgstr ""

#: wraithguard_toolkit_gui.py:3900
msgid "message:"
msgstr ""

#: wraithguard_toolkit_gui.py:3907
msgid "What to tell the person, and what to do about it. Ordering rules carry no message; the warning rules are much less useful without one.\n\nA message containing ']' is written in the block form automatically, because a ']' would otherwise close the rule label early."
msgstr ""

#: wraithguard_toolkit_gui.py:3916
msgid "(Ref:) source:"
msgstr ""

#: wraithguard_toolkit_gui.py:3923
msgid "Where this rule's claim comes from: a readme filename, a forum post, a URL. The guidelines ask for one on every rule so that someone else can check it, or correct it.\n\nA URL gets whitespace before the closing parenthesis automatically -- pages that auto-link URLs otherwise swallow the ')' into the link."
msgstr ""

#: wraithguard_toolkit_gui.py:3932
msgid "@section:"
msgstr ""

#: wraithguard_toolkit_gui.py:3939
msgid "Optional heading written above the rule. The rule-base groups rules into sections, roughly one per mod, to keep the file navigable."
msgstr ""

#: wraithguard_toolkit_gui.py:3947
msgid "highlight:"
msgstr ""

#: wraithguard_toolkit_gui.py:3952
msgid "none"
msgstr ""

#: wraithguard_toolkit_gui.py:3959
msgid "%(mark)s = %(meaning)s"
msgstr ""

#: wraithguard_toolkit_gui.py:3966
msgid "; comment:"
msgstr ""

#: wraithguard_toolkit_gui.py:3973
msgid "A ';' comment written above the rule. mlox strips these before reading."
msgstr ""

#: wraithguard_toolkit_gui.py:3982
msgid "Preview"
msgstr ""

#: wraithguard_toolkit_gui.py:4001
msgid "Append rule"
msgstr ""

#: wraithguard_toolkit_gui.py:4005
msgid "Write the rule to the file above. Refused while there is an error: mlox silently discards a rule it cannot use, so this is the only place you would find out.\n\nWarnings do not block -- they are the guidelines' advice, not the parser's requirements."
msgstr ""

#: wraithguard_toolkit_gui.py:4017
msgid "Rule guide"
msgstr ""

#: wraithguard_toolkit_gui.py:4023
msgid "Open the rule reference: what each rule kind says, how expressions nest, and the conventions the rule-base follows.\n\nIt opens in your browser, so it can sit beside this window while you work."
msgstr ""

