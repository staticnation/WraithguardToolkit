msgstr ""

#: wraithguard/gui/conflicts.py:1874
msgid "Judged %(count)d record(s); %(losers)d plugin(s) losing work."
msgstr ""

#: wraithguard/gui/conflicts.py:1935
msgid "Plugin conflict summary"
msgstr ""

#: wraithguard/gui/conflicts.py:1944
msgid "How each mod fares across the conflicts listed. 'Loses' counts records it edits where a later plugin overwrote the change with something different -- work that never reaches the game. 'Same as original' counts records it redefines without changing anything, which is usually removable but not always: an unchanged dialogue response may be there to hold a line's position in its topic."
msgstr ""

