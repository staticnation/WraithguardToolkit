msgstr ""

#: wraithguard_toolkit_gui.py:2103
msgid "Theme imported"
msgstr ""

#: wraithguard_toolkit_gui.py:2104
msgid "Imported \"%(name)s\" and set it as the active log theme."
msgstr ""

