# syntax=docker/dockerfile:1
#
# A local container build. Its binary carries wraithguard-viewer as a bare ELF, so the
# viewer needs WebKitGTK 4.1 installed on the machine that runs it. The released Linux
# builds are the plain .tar.gz (.github/workflows/build-linux.yml), the same thing as
# a folder, and the Flatpak (packaging/flatpak/, build-flatpak.yml) for the Steam Deck.

# ---------------------------------------------------------------------------
# Stage 1: build wraithguard-viewer, the Rust/Tauri binary that replaced
# pywebview as the in-app window for cell maps / the NIF viewer / conflict
# views (see viewer-shell/). Built in its own stage so the final image
# doesn't need a Rust toolchain, only the resulting binary.
# ---------------------------------------------------------------------------
FROM rust:1-slim-bookworm AS viewer-builder

# Tauri v2 Linux build prerequisites. webkit2gtk-4.1 (not 4.0) is the
# correct package name on Debian bookworm / Ubuntu 22.04+.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libssl-dev \
    libxdo-dev \
    pkg-config \
    build-essential \
    file \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /viewer-shell
COPY viewer-shell/ .
# tauri-build wants the icon present at compile time; kept as one copy in
# the repo root rather than duplicated into viewer-shell/ -- see
# viewer-shell/icons/README.md.
COPY wraithguard_toolkit_icon.ico icons/wraithguard_toolkit_icon.ico
RUN cargo build --release && \
    ls -lh target/release/wraithguard-viewer

# ---------------------------------------------------------------------------
# Stage 2: the Python build, on free-threaded Python 3.14 (3.14t) -- the same
# interpreter the Windows, Linux and macOS release builds freeze.
# ---------------------------------------------------------------------------
# Docker Hub's official `python` image publishes no free-threaded variant, so the
# interpreter comes from uv, which installs python-build-standalone's 3.14t (with
# tkinter and its own Tcl/Tk) onto a plain Debian base.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_PYTHON_INSTALL_DIR=/opt/python

# Runtime (not -dev) libraries for wraithguard-viewer, the X11 libraries Tk loads,
# and a C toolchain for the Rust backend's build scripts (zstd).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    file \
    ca-certificates \
    libx11-6 \
    libxext6 \
    libxft2 \
    libxrender1 \
    libxss1 \
    libfontconfig1 \
    libwebkit2gtk-4.1-0 \
    libgtk-3-0 \
    libayatana-appindicator3-1 \
    librsvg2-2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN uv python install 3.14t && \
    uv venv --seed --python 3.14t /opt/wraithguard-venv

ENV PATH="/opt/wraithguard-venv/bin:${PATH}"

# Fail here, not after a long PyInstaller run, if this is not a free-threaded
# interpreter -- the shipped binary would silently keep the GIL.
RUN python -c "import sys; assert not sys._is_gil_enabled(), 'GIL is enabled -- not a free-threaded build'; print(sys.version, 'free-threaded OK')"

# No zstandard: Python 3.14's stdlib `compression.zstd` already covers the
# tes3conv bytecode path, so the third-party C extension isn't needed.
# No pywebview, no pythonnet -- wraithguard-viewer (copied in below) replaces
# both entirely and needs nothing from pip.
RUN python -m pip install --upgrade \
        pip \
        setuptools \
        wheel \
    && \
    python -m pip install --no-cache-dir \
        pyinstaller \
        tkinterweb \
        tkinterdnd2 \
        PyYAML \
        ijson \
        certifi

# The Rust backend (native/, on greatness7's tes3 crates), built for this
# interpreter. The toolchain is only needed for this step, so it is removed after.
COPY native/ /tmp/native/
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal && \
    PATH="/root/.cargo/bin:${PATH}" python -m pip install --no-cache-dir /tmp/native && \
    rm -rf /root/.rustup /root/.cargo /tmp/native && \
    apt-get purge -y curl && rm -rf /var/lib/apt/lists/*

COPY --from=viewer-builder /viewer-shell/target/release/wraithguard-viewer /opt/wraithguard-viewer

WORKDIR /src

CMD ["/bin/bash", "-lc", "\
    set -Eeuo pipefail; \
    rm -rf /src/build/wraithguard_toolkit_gui; \
    rm -f /src/dist/wraithguard_toolkit_gui; \
    /opt/wraithguard-venv/bin/python -m PyInstaller \
        --noconfirm \
        --onefile \
        --windowed \
        --clean \
        --name wraithguard_toolkit_gui \
        --icon /src/wraithguard_toolkit_icon.ico \
        --collect-all certifi \
        --hidden-import tkinterweb \
        --add-binary /opt/wraithguard-viewer:. \
        --collect-submodules wraithguard \
        --hidden-import wraithguard_native \
        --add-data /src/wraithguard_toolkit.py:. \
        --add-data /src/README.md:. \
        --add-data /src/QUICKSTART.md:. \
        --add-data /src/MLOX_RULES.md:. \
        --add-data /src/wraithguard/viz/assets:assets \
        --add-data /src/wraithguard_toolkit_icon.ico:. \
        /src/wraithguard_toolkit_gui.py; \
    echo; \
    echo '============================================================'; \
    echo ' Linux build complete'; \
    echo '============================================================'; \
    ls -lh /src/dist/wraithguard_toolkit_gui; \
    file /src/dist/wraithguard_toolkit_gui \
"]
