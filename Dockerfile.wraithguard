# Free-threaded (GIL-free) Python 3.14 -- the `3.14t` build the app ships. The
# official Docker image *is* free-threaded Python, so `python`/`pip` here are the
# target interpreter; no apt python3/-dev/-venv (those would be Debian's stock,
# GIL-bearing Python and the wrong ABI for the wheels below). The `-slim` base is
# Debian bookworm, so the runtime libraries below use Debian names (notably
# `libasound2`, not Ubuntu 24.04's t64-renamed `libasound2t64`).
#
# NOTE (free-threading, still settling): PyQt6/QtWebEngine and tkinterdnd2 may not
# yet publish a `cp314t` wheel; pip will source-build or fail on this base while
# the ecosystem catches up. `python3-tk` is apt'd for Tk (the fallback viewer),
# and `python3-gi` is deliberately *not* installed -- it targets Debian's system
# Python, not this one; the Linux viewer uses pywebview's Qt backend, not GTK/gi.
FROM python:3.14t-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-tk \
    tk \
    libzstd-dev \
    build-essential \
    file \
    ca-certificates \
    libegl1 \
    libgl1 \
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-render-util0 \
    libxcb-xinerama0 \
    libxcb-xkb1 \
    libxcb-shape0 \
    libdbus-1-3 \
    libnss3 \
    libnspr4 \
    libasound2 \
    libpulse0 \
    libxkbfile1 \
    libxtst6 \
    && rm -rf /var/lib/apt/lists/*

# Fail early if the base is somehow not free-threaded, before the heavy pip build.
RUN python -c "import sys; assert not sys._is_gil_enabled(), 'GIL is enabled -- not a free-threaded base image'; print('free-threaded OK')"

RUN python -m venv /opt/wraithguard-venv

ENV PATH="/opt/wraithguard-venv/bin:${PATH}"

# No zstandard: Python 3.14's stdlib `compression.zstd` covers the tes3conv
# bytecode path, and the C extension has no free-threaded wheel yet.
RUN python -m pip install --upgrade \
        pip \
        setuptools \
        wheel \
    && \
    python -m pip install --no-cache-dir \
        pyinstaller \
        "pywebview[qt]" \
        tkinterweb \
        tkinterdnd2 \
        PyYAML \
        ijson \
        certifi

WORKDIR /src

CMD ["/bin/bash", "-lc", "\
    set -Eeuo pipefail; \
    rm -rf /src/build/wraithguard_toolkit_gui; \
    rm -f /src/dist/wraithguard_toolkit_gui; \
    python -m PyInstaller \
        --noconfirm \
        --onefile \
        --windowed \
        --clean \
        --name wraithguard_toolkit_gui \
        --icon /src/wraithguard_toolkit_icon.ico \
        --collect-all webview \
        --collect-all clr_loader \
        --collect-all pythonnet \
        --collect-all certifi \
        --hidden-import clr \
        --hidden-import webview.platforms.qt \
        --hidden-import tkinterweb \
        --exclude-module PySide6 \
        --exclude-module PySide2 \
        --exclude-module shiboken6 \
        --exclude-module PyQt6.QtQml \
        --exclude-module PyQt6.QtQuick \
        --exclude-module PyQt6.QtQuickWidgets \
        --exclude-module PyQt6.QtQuick3D \
        --exclude-module PyQt6.QtPositioning \
        --exclude-module PyQt6.QtDBus \
        --exclude-module PyQt6.QtMultimedia \
        --exclude-module PyQt6.QtSpatialAudio \
        --exclude-module PyQt6.QtTextToSpeech \
        --collect-submodules wraithguard \
        --add-data /src/wraithguard_toolkit.py:. \
        --add-data /src/README.md:. \
        --add-data /src/QUICKSTART.md:. \
        --add-data /src/MLOX_RULES.md:. \
        --add-data /src/wraithguard/viz/assets:assets \
        --add-data /src/wraithguard_toolkit_icon.ico:. \
        /src/wraithguard_toolkit_gui.py; \
    echo; \
    echo '============================================================'; \
    echo ' Linux build complete'; \
    echo '============================================================'; \
    ls -lh /src/dist/wraithguard_toolkit_gui; \
    file /src/dist/wraithguard_toolkit_gui \
"]