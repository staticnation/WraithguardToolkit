+/// The kinds a placed object can be: OpenMW's id index holds these and no others.
+const PLACEABLE: [&Tag; 21] = [
+    b"ACTI", b"ALCH", b"APPA", b"ARMO", b"BODY", b"BOOK", b"CLOT", b"CONT", b"CREA", b"DOOR", b"INGR", b"LEVC", b"LEVI",
+    b"LIGH", b"LOCK", b"MISC", b"NPC_", b"PROB", b"REPA", b"STAT", b"WEAP",
+];
+
+fn is_placeable(tag: &Tag) -> bool {
+    PLACEABLE.contains(&tag)
+}
+
+/// For every id the load order defines as more than one placeable kind, the kind a placed
+/// object of it is - as OpenMW resolves it, not by load order. OpenMW keeps each kind's
+/// records apart (both versions exist), and after loading builds one id -> kind index by
+/// walking its stores in the order of their record-name number (the tag read as a
+/// little-endian `u32`), the later store overwriting: so the kind whose tag is greatest
+/// that way wins - in effect the last letter (`WEAP` over `MISC`, `NPC_` over all). A
+/// deletion takes that kind's record out first. The Construction Set refuses such a load
+/// order ("Matching IDs") and Morrowind.exe will not load it; OpenMW does, and places this.
+pub fn placed_types(parsed: &[PluginData]) -> HashMap<String, Tag> {
+    let mut live: std::collections::HashSet<(Tag, String)> = std::collections::HashSet::new();
+    let mut ever: HashMap<String, std::collections::HashSet<Tag>> = HashMap::new();
+    for d in parsed {
+        for (id, tag) in &d.ids {
+            if is_placeable(tag) {
+                live.insert((*tag, id.clone()));
+                ever.entry(id.clone()).or_default().insert(*tag);
+            }
+        }
+        for (id, tag) in &d.ids_deleted {
+            live.remove(&(*tag, id.clone()));
+        }
+    }
+    // Only ids some plugin made more than one kind; for each, the live kind that ranks
+    // highest. An id with no live kind left is not in the map (its deletions apply).
+    ever.into_iter()
+        .filter(|(_, kinds)| kinds.len() > 1)
+        .filter_map(|(id, kinds)| {
+            kinds
+                .into_iter()
+                .filter(|t| live.contains(&(*t, id.clone())))
+                .max_by_key(|t| u32::from_le_bytes(*t))
+                .map(|t| (id, t))
+        })
+        .collect()
+}
--- a/crates/gardenfell-world/tests/wraithguard.rs
+++ b/crates/gardenfell-world/tests/wraithguard.rs
@@ -0,0 +1,75 @@
+//! Patch 0007 from Wraithguard (Static): with `LoadOpts::openmw_kinds`, what a placed
+//! object of an id defined as two kinds is, as OpenMW resolves it (`esmstore.cpp`:
+//! records load into their own kind's store, a deletion erases from that store only, and
+//! `rebuildIdsIndex` walks the stores in record-name order, the later overwriting).
+
+use gardenfell_install::vfs::Vfs;
+use gardenfell_world::world::{LoadOpts, World};
+use std::path::PathBuf;
+
+/// A record as a plugin file holds it: tag, size, header words, then subrecords.
+fn record(tag: &[u8; 4], subs: &[(&[u8; 4], &[u8])]) -> Vec<u8> {
+    let mut body = Vec::new();
+    for (t, d) in subs {
+        body.extend_from_slice(*t);
+        body.extend_from_slice(&(d.len() as u32).to_le_bytes());
+        body.extend_from_slice(d);
+    }
+    let mut out = tag.to_vec();
+    out.extend_from_slice(&(body.len() as u32).to_le_bytes());
+    out.extend_from_slice(&[0; 8]);
+    out.extend(body);
+    out
+}
+
+fn header() -> Vec<u8> {
+    let mut hedr = vec![0u8; 300];
+    hedr[..4].copy_from_slice(&1.3f32.to_le_bytes());
+    record(b"TES3", &[(b"HEDR", &hedr)])
+}
+
+fn write(dir: &PathBuf, name: &str, parts: &[Vec<u8>]) -> PathBuf {
+    let p = dir.join(name);
+    std::fs::write(&p, parts.concat()).unwrap();
+    p
+}
+
+fn tmp(name: &str) -> PathBuf {
+    let d = std::env::temp_dir().join(format!("gdn-wg-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&d);
+    std::fs::create_dir_all(&d).unwrap();
+    d
+}
+
+#[test]
+fn an_id_of_two_kinds_is_placed_as_openmw_places_it_whatever_the_order() {
+    // A.esp has `wg_clash` as a weapon; B.esp, later, as a misc item. OpenMW keeps both and
+    // places the weapon (WEAP's tag outranks MISC's), so the world draws the weapon's mesh.
+    let dir = tmp("clash");
+    let a = write(&dir, "A.esp", &[header(), record(b"WEAP", &[(b"NAME", b"wg_clash\0"), (b"MODL", b"w\\sword.nif\0")])]);
+    let b = write(&dir, "B.esp", &[header(), record(b"MISC", &[(b"NAME", b"WG_Clash\0"), (b"MODL", b"m\\cup.nif\0")])]);
+    let w = World::load_with(&[a.clone(), b.clone()], &Vfs::default(), false, &LoadOpts { openmw_kinds: true, ..LoadOpts::default() });
+    assert_eq!(w.models.get("wg_clash").map(String::as_str), Some("w\\sword.nif"));
+    // The other order places the weapon too.
+    let w = World::load_with(&[b, a], &Vfs::default(), false, &LoadOpts { openmw_kinds: true, ..LoadOpts::default() });
+    assert_eq!(w.models.get("wg_clash").map(String::as_str), Some("w\\sword.nif"));
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
+#[test]
+fn a_deleted_kind_gives_way_to_the_other() {
+    let dir = tmp("dele");
+    let a = write(
+        &dir,
+        "A.esp",
+        &[
+            header(),
+            record(b"WEAP", &[(b"NAME", b"x\0"), (b"MODL", b"w\\sword.nif\0")]),
+            record(b"MISC", &[(b"NAME", b"x\0"), (b"MODL", b"m\\cup.nif\0")]),
+        ],
+    );
+    let b = write(&dir, "B.esp", &[header(), record(b"WEAP", &[(b"NAME", b"x\0"), (b"DELE", &[0; 4])])]);
+    let w = World::load_with(&[a, b], &Vfs::default(), false, &LoadOpts { openmw_kinds: true, ..LoadOpts::default() });
+    assert_eq!(w.models.get("x").map(String::as_str), Some("m\\cup.nif"));
+    let _ = std::fs::remove_dir_all(&dir);
+}
