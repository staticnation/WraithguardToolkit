{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wraithguard-toolkit",
  "version": "5.0.4",
  "identifier": "dev.wraithguard.viewer",
  "build": {
    "frontendDist": "ui-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/wraithguard_toolkit_icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Sort, check, preview and edit a Morrowind load order on OpenMW",
    "resources": {
      "../QUICKSTART.md": "QUICKSTART.md",
      "../README.md": "README.md",
      "../MLOX_RULES.md": "MLOX_RULES.md",
      "../MERGED_LANDS.md": "MERGED_LANDS.md",
      "../CHANGELOG.md": "CHANGELOG.md",
      "../CREDITS.md": "CREDITS.md",
      "../License/": "License/",
      "ui/LICENSE": "License/page-GPL-2.0.txt"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
