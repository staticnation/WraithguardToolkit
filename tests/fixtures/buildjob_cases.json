     "path": " {tmp}/Data Files/New.esp "
    }
   },
   "dirs": [
    "Data Files"
   ],
   "files": [
    "Data Files/Old Patch.esp"
   ],
   "expect": "{tmp}/Data Files/New.esp"
  },
