#!/bin/sh
# Starts the viewer shell from inside the AppImage, with fallbacks for WebKit's graphics.
#
# WebKitGTK aborts at start-up (SIGABRT, exit 134) when it cannot create an EGL display -
# "Could not create default EGL display: EGL_BAD_PARAMETER. Aborting..." - which a
# Steam Deck showed with 4.2.0's AppImage. build-appimage.sh no longer bundles the
# graphics libraries that cause it, and this retries anyway if WebKit still aborts
# within the first few seconds:
#   1. as asked;
#   2. on X11 (XWayland) instead of Wayland, where there is a Wayland session;
#   3. without WebKit's GPU compositing (the page's 3D view may then be unavailable,
#      but the window opens and says so).
# An explicit setting in the environment is left alone. Exit status is the viewer's.
BIN="$(dirname "$(readlink -f "$0")")/wraithguard-viewer"
: "${WEBKIT_DISABLE_DMABUF_RENDERER:=1}"
export WEBKIT_DISABLE_DMABUF_RENDERER
# GTK's accessibility bridge, bundled from the build machine, talking to the host's
# AT-SPI bus: on the Deck it printed "atk-bridge: get_device_events_reply: unknown
# signature". The viewer has no use for it; off unless asked for.
: "${NO_AT_BRIDGE:=1}"
export NO_AT_BRIDGE

run() {
  start=$(date +%s)
  "$BIN" "$@"
  rc=$?
  took=$(( $(date +%s) - start ))
}

# An abort within ten seconds is a start-up failure worth another try; anything else
# (the window was used and closed, an ordinary error) is the answer.
failed_early() { [ "$rc" -eq 134 ] && [ "$took" -lt 10 ]; }

run "$@"
if failed_early && [ -n "$WAYLAND_DISPLAY" ] && [ -z "$GDK_BACKEND" ]; then
  echo "wraithguard-viewer: WebKit could not start on Wayland; trying X11" >&2
  GDK_BACKEND=x11; export GDK_BACKEND
  run "$@"
fi
if failed_early && [ -z "$WEBKIT_DISABLE_COMPOSITING_MODE" ]; then
  echo "wraithguard-viewer: WebKit could not open the GPU; trying without GPU compositing" >&2
  WEBKIT_DISABLE_COMPOSITING_MODE=1; export WEBKIT_DISABLE_COMPOSITING_MODE
  run "$@"
fi
exit "$rc"
