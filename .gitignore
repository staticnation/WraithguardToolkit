# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-t/
venv/

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Build output ---
build/*/
dist/
*.spec
*.exe
# Packaged release archives (produced by the build, not source).
/WraithguardToolkit*.zip

# --- Keys (never commit one) ---
*.key

# --- Runtime artefacts written next to the app ---
# Traces, scan caches and generated reports are per-run, never source.
*.log
cell_map.html
cell_map_*.html
tes3conv_json/
tes3cmd_staging/
# The cell preview's parsed-plugin cache -- per-machine, per-load-order binary
# sidecars written beside the app, exactly like the tes3conv spool above.
plugin_cache/
output/
wraithguard_toolkit_settings.json
log_themes.json

# --- Backups made by this tool and by the tools it drives ---
*.bak
*.bak-*
*.backup.*
*.preclean.bak
*.masterfix.bak
*~[0-9].esp
*~[0-9].esm

# --- Compiled translation catalogues ---
# Built by tools/build_locale.py from locale/translations/<lang>.json. The
# shipped catalogues are committed so the app loads them from a plain source
# checkout (there is no compile step at install time); stray/dev .mo elsewhere
# stay ignored.
locale/**/*.mo
!locale/*/LC_MESSAGES/wraithguard_toolkit.mo

# Sampled game assets, copied in by tools/check_nif_layouts.py --collect.
# Real Morrowind meshes: useful locally, not ours to redistribute.
NifCorpus/samples/
nif_report.json

# Cell viewer page, assembled by viewer-shell/build.rs from viewer-shell/ui.
viewer-shell/ui-dist/
viewer-shell/gen/
viewer-shell/target/
viewer-shell/**/target/
# The Rust backend's cargo output (pip install ./native builds here).
native/target/
viewer-shell/icons/wraithguard_toolkit_icon.ico
viewer-shell/ui/tests/node_modules/

# The cell viewer's per-user files, written beside the app at run time.
wraithguard_cellviewer.profile.json
wraithguard_cellviewer.profile.toml
wraithguard_cellviewer_extra.json
wraithguard_cellviewer_setup.cfg

# A local archive of viewer-shell/, not part of the source.
viewer-shell.zip
